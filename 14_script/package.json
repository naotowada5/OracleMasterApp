{
  "name": "@oracle-master-app/script",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oracle Master 資格学習PWA — 初期データ投入スクリプト",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "validate": "node src/import-questions.mjs --dry-run",
    "import:dev": "node src/import-questions.mjs --env dev",
    "import:stg": "node src/import-questions.mjs --env stg",
    "import:prod": "node src/import-questions.mjs --env prod",
    "purge:dev": "node src/purge.mjs --env dev",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
